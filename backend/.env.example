# Copy to .env and set a long random value.
# The add-on sends the same value in the X-API-Key header.
API_KEY=change-me-to-a-long-random-string

# Optional: Gemini API key (aistudio.google.com/apikey). Leave unset to run rules only.
# GEMINI_API_KEY=

# Interactive API docs at /docs (turn off in production).
ENABLE_DOCS=true
